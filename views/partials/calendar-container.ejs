<div id="calendar-container">
    <header class="site-header">
      <button hx-get="/events?month=<%= month-1 %>" hx-target="#calendar-container" hx-swap="outerHTML" <%= month==0? "disabled" : "" %>>Previous</button>
        <h2>Calendar for <%= new Date(year, month).toLocaleDateString("en-US", {month: "long", year: "numeric"}) %></h2>
        <button hx-get="/events?month=<%= month+1 %>" hx-target="#calendar-container" hx-swap="outerHTML" <%= month==11? "disabled" : "" %>>Next</button>

      <nav>
        <a href="/">Home</a>
        <a href="/events">Calendar</a>
      </nav>
    </header><div class="calendar">
      <div>Sun</div>
      <div>Mon</div>
      <div>Tue</div>
      <div>Wed</div>
      <div>Thu</div>
      <div>Fri</div>
      <div>Sat</div>
      <% for(let i = 0;i<firstDay;i++){ %>
        <div></div>
      <% } %>

      <% for(let i = 1;i<=numDays;i++){ %>
        <div class="day" data-day="<%= i %>" data-month="<%= month%>"><%= i %>
          <div id="event-list-<%= month + 1 %>-<%= i %>">
            <% for(let event of events) { %>
              <% if(event.day==i && event.month-1==month) { %>
                <div class="event" id="event-<%= event.event_id %>"data-event="<%= JSON.stringify(event) %>">
                  <%= event.title %>
                </div>
            <% } } %>
          </div>
        </div>
      <% } %>
    </div>
    </div>
